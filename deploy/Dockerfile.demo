# Stage 1: Build static musl binary for standalone quickstart demo
FROM rust:1.88-slim-bookworm AS builder

WORKDIR /usr/src/trust-gateway

# Install musl compiler tools and OpenSSL musl dependencies
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    build-essential \
    musl-tools \
    binutils \
    && rm -rf /var/lib/apt/lists/*

# Add x86_64-unknown-linux-musl target
RUN rustup target add x86_64-unknown-linux-musl

# Copy workspace manifests and sources
COPY . .

# Build quickstart-standalone static binary for musl target
RUN RUSTFLAGS="-C strip=symbols" cargo build --release --target x86_64-unknown-linux-musl -p quickstart-standalone

# Stage 2: Ultra-minimal Alpine runtime image (~10-15 MB total)
FROM alpine:3.20

RUN apk add --no-cache ca-certificates

COPY --from=builder /usr/src/trust-gateway/target/x86_64-unknown-linux-musl/release/quickstart-standalone /usr/local/bin/quickstart-standalone

ENTRYPOINT ["/usr/local/bin/quickstart-standalone"]
